# Copy this file to .env and fill in real values. Never commit .env.

# Environment: development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local (docker compose):  postgresql://postgres:postgres@localhost:5433/task_boards
# Neon:                    postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/task_boards

# Separate database for automated tests (all its data is deleted when tests run!)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/task_boards_test

# Long random secret (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Token lifetime in minutes (default 1440 = 24 hours)
JWT_EXPIRES_IN_MINUTES=1440

# Comma-separated list of allowed frontend origins (React dev server, deployed site)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Login/register rate limit: max attempts per IP per window
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Password used by `npm run db:seed` for the demo users (development only).
# In production the seed refuses to run unless SEED_PASSWORD is set explicitly.
SEED_PASSWORD=Demo1234!
